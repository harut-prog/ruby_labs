h1.mb-4 Каталог книг

- if current_user.librarian?
  section.card.mb-4 aria-labelledby='new-book-title'
    .card-body
      h2#new-book-title.h5 Добавить книгу
      p.text-muted Укажите название, автора, ISBN и год издания.
      = link_to 'Новая книга', new_book_path, class: 'btn btn-primary'

section.mb-4 aria-labelledby='book-search-title'
  h2#book-search-title.h4.mb-3 Поиск и фильтры
  = form_with url: books_path, method: :get, data: { turbo_frame: 'books' } do |f|
    .mb-3
      = f.label :query, 'Название, ISBN или автор', class: 'form-label'
      = f.search_field :query, value: params[:query], class: 'form-control', placeholder: 'Начните вводить запрос', data: { instant_search: true }
    .mb-3
      = f.label :author_id, 'Автор', class: 'form-label'
      = f.collection_select :author_id, Author.order(:name), :id, :name, { include_blank: 'Все авторы', selected: params[:author_id] }, class: 'form-select'
    .mb-3
      = f.label :available, 'Доступность', class: 'form-label'
      = f.select :available, [['Все книги', ''], ['Доступны', 'true'], ['Выданы', 'false']], { selected: params[:available] }, class: 'form-select'
    .d-flex.flex-wrap.gap-2
      = f.submit 'Применить', class: 'btn btn-primary'
      = link_to 'Сбросить', books_path, class: 'btn btn-outline-secondary'

section aria-labelledby='book-list-title'
  h2#book-list-title.h4.mb-3 Книги в каталоге
  = turbo_frame_tag 'books' do
    - if @books.empty?
      p.text-muted Ничего не найдено. Измените запрос или сбросьте фильтры.
    - else
      .row.g-3
        = render partial: 'books/book_card', collection: @books, as: :book
