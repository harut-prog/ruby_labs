h1.mb-4 = @book.title

.row.g-4.mb-4
  - if @book.cover.attached?
    .col-md-4.col-lg-3
      = image_tag cover_path(@book), class: 'book-cover', alt: "Обложка книги #{@book.title}"
  .col
    dl.row
      dt.col-sm-3 Автор
      dd.col-sm-9 = link_to @book.author.name, author_path(@book.author)
      dt.col-sm-3 ISBN
      dd.col-sm-9 = @book.isbn
      dt.col-sm-3 Год издания
      dd.col-sm-9 = @book.published_year
      dt.col-sm-3 Доступность
      dd.col-sm-9 = book_status(@book)

p = link_to 'Назад в каталог', books_path, class: 'btn btn-outline-secondary'

/ УПРАВЛЕНИЕ ЗАПИСЬЮ
- if current_user.librarian?
  .d-flex.flex-wrap.align-items-center.gap-2.mt-4
    = link_to 'Редактировать', edit_book_path(@book), class: 'btn btn-outline-primary'
    = link_to 'Загрузить обложку', attachment_path(kind: 'cover', id: @book.id), class: 'btn btn-outline-secondary'
    = button_to 'Удалить', book_path(@book), method: :delete, class: 'btn btn-outline-danger', form: { data: { turbo_confirm: 'Удалить запись?' } }

- if current_user.librarian?
  section.card.mt-4 aria-labelledby='word-document-title'
    .card-body
      .d-flex.align-items-center.gap-2.mb-2
        h2#word-document-title.h5.mb-0 Документ Word
        span.badge.text-bg-primary DOCX
      h3.h6.mt-3 Карточка книги
      p.text-muted Название, автор, ISBN, год издания и текущая доступность книги.
      p.text-muted.small Файл можно открыть в Microsoft Word или LibreOffice Writer.
      = link_to 'Скачать документ (.docx)', book_word_path(@book), class: 'btn btn-outline-primary', data: { turbo: false }
