h1.mb-4 Выдачи книг

- if current_user.librarian?
  section.card.mb-4 aria-labelledby='new-borrowing-title'
    .card-body
      h2#new-borrowing-title.h5 Оформить новую выдачу
      p.text-muted Выберите книгу и читателя, чтобы оформить выдачу.
      = link_to 'Выдать книгу', new_borrowing_path, class: 'btn btn-primary'

section aria-labelledby='existing-borrowings-title'
  h2#existing-borrowings-title.h4.mb-3 Оформленные выдачи
  - if @borrowings.empty?
    p.text-muted Выдач пока нет.
  - else
    .table-responsive
      table.table.table-striped.align-middle
        thead
          tr
            th scope='col' Книга
            th scope='col' Читатель
            th scope='col' Дата выдачи
            th scope='col' Плановый возврат
            th scope='col' Статус
            th scope='col' Подробности
        tbody
          - @borrowings.each do |borrowing|
            tr
              td = borrowing.book.title
              td = borrowing.member.name
              td = borrowing.borrowed_on&.strftime('%d.%m.%Y') || '—'
              td = borrowing.due_on&.strftime('%d.%m.%Y') || '—'
              td
                - if borrowing.returned_on
                  span.badge.text-bg-success Возвращена
                - elsif borrowing.due_on && borrowing.due_on < Date.current
                  span.badge.text-bg-danger Просрочена
                - else
                  span.badge.text-bg-primary На руках
              td = link_to 'Открыть', borrowing_path(borrowing), class: 'btn btn-sm btn-outline-primary'
- if current_user.librarian?
  section.card.mt-4 aria-labelledby='excel-reports-title'
    .card-body
      .d-flex.align-items-center.gap-2.mb-2
        h2#excel-reports-title.h5.mb-0 Отчёты Excel
        span.badge.text-bg-success XLSX
      p.text-muted.mb-4 Скачайте отчёт для просмотра в Microsoft Excel или LibreOffice Calc.
      .row.g-4
        .col-md-6
          h3.h6 Все выдачи
          p.text-muted.small Список всех выдач: читатели, книги, даты выдачи и возврата.
          = link_to 'Скачать все выдачи (.xlsx)', '/reports/borrowings.xlsx', class: 'btn btn-outline-success', data: { turbo: false }
        .col-md-6
          h3.h6 Должники
          p.text-muted.small Невозвращённые книги с истёкшим сроком и числом дней просрочки.
          = link_to 'Скачать должников (.xlsx)', '/reports/overdue.xlsx', class: 'btn btn-outline-success', data: { turbo: false }
